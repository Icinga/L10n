#: https://github.com/Icinga/ipl-validator/blob/f1dcd1d7594bc4b902616b875d5ddf8f0c1d907c/src/BetweenValidator.php#L140
#, php-format
msgid "'%s' is not between '%s' and '%s', inclusively"
msgstr "'%s' не между '%s' и '%s' включительно"

#: https://github.com/Icinga/ipl-validator/blob/f1dcd1d7594bc4b902616b875d5ddf8f0c1d907c/src/BetweenValidator.php#L150
#, php-format
msgid "'%s' is not between '%s' and '%s'"
msgstr "'%s' не между '%s' и '%s'"

#: https://github.com/Icinga/ipl-validator/blob/f1dcd1d7594bc4b902616b875d5ddf8f0c1d907c/src/CidrValidator.php#L23
#, php-format
msgid "CIDR \"%s\" does not conform to the required format $address/$prefix"
msgstr "CIDR \"%s\" не соответствует требуемому формату $address/$prefix"

#: https://github.com/Icinga/ipl-validator/blob/f1dcd1d7594bc4b902616b875d5ddf8f0c1d907c/src/CidrValidator.php#L33
#, php-format
msgid "CIDR \"%s\" contains an invalid address"
msgstr "CIDR \"%s\" содержит недопустимый адрес"

#: https://github.com/Icinga/ipl-validator/blob/f1dcd1d7594bc4b902616b875d5ddf8f0c1d907c/src/CidrValidator.php#L39
#, php-format
msgid "Prefix of CIDR \"%s\" must be a number"
msgstr "Префикс CIDR \"%s\" должен быть числом"

#: https://github.com/Icinga/ipl-validator/blob/f1dcd1d7594bc4b902616b875d5ddf8f0c1d907c/src/CidrValidator.php#L50
#, php-format
msgid ""
"Prefix length of CIDR \"%s\" must be between 0 and %d for IPv%d addresses"
msgstr "Длина префикса CIDR \"%s\" должна быть от 0 до %d для адресов IPv%d"

#: https://github.com/Icinga/ipl-validator/blob/f1dcd1d7594bc4b902616b875d5ddf8f0c1d907c/src/DateTimeValidator.php#L41
msgid "Invalid date/time given."
msgstr "Указана неверная дата/время."

#: https://github.com/Icinga/ipl-validator/blob/f1dcd1d7594bc4b902616b875d5ddf8f0c1d907c/src/DateTimeValidator.php#L52
#, php-format
msgid "Date/time string not in the expected format: %s"
msgstr "Строка даты/времени не в ожидаемом формате: %s"

#: https://github.com/Icinga/ipl-validator/blob/f1dcd1d7594bc4b902616b875d5ddf8f0c1d907c/src/EmailAddressValidator.php#L124
#, php-format
msgid "'%s' can not be matched against dot-atom format or quoted-string format"
msgstr ""
"'%s' не может быть сопоставлен с форматом атомов точек или строк в кавычках"

#: https://github.com/Icinga/ipl-validator/blob/f1dcd1d7594bc4b902616b875d5ddf8f0c1d907c/src/EmailAddressValidator.php#L129
#, php-format
msgid "Hence '%s' is not a valid local part for email address '%s'"
msgstr ""
"Следовательно, '%s' не является действительной локальной частью для адреса "
"электронной почты '%s'"

#: https://github.com/Icinga/ipl-validator/blob/f1dcd1d7594bc4b902616b875d5ddf8f0c1d907c/src/EmailAddressValidator.php#L159
#, php-format
msgid "host name %s is a domain literal and is invalid"
msgstr "Имя хоста %s является доменным литералом и недействительно"

#: https://github.com/Icinga/ipl-validator/blob/f1dcd1d7594bc4b902616b875d5ddf8f0c1d907c/src/EmailAddressValidator.php#L171
#, php-format
msgid "%s is not a valid domain name for email address %s."
msgstr ""
"%s не является действительным доменным именем для адреса электронной почты "
"%s."

#: https://github.com/Icinga/ipl-validator/blob/f1dcd1d7594bc4b902616b875d5ddf8f0c1d907c/src/EmailAddressValidator.php#L222
#, php-format
msgid ""
"'%s' is not a valid email address in the basic format local-part@hostname"
msgstr ""
"'%s' не является действительным адресом электронной почты в формате local-"
"part@hostname"

#: https://github.com/Icinga/ipl-validator/blob/f1dcd1d7594bc4b902616b875d5ddf8f0c1d907c/src/EmailAddressValidator.php#L234
#, php-format
msgid "'%s' exceeds the allowed length"
msgstr "Длина '%s' превышает допустимую"

#: https://github.com/Icinga/ipl-validator/blob/f1dcd1d7594bc4b902616b875d5ddf8f0c1d907c/src/EmailAddressValidator.php#L270
#: https://github.com/Icinga/ipl-validator/blob/f1dcd1d7594bc4b902616b875d5ddf8f0c1d907c/src/EmailAddressValidator.php#L309
#, php-format
msgid ""
"'%s' does not appear to have a valid MX record for the email address '%s'"
msgstr ""
"Похоже, что у '%s' нет действительной MX-записи для адреса электронной почты "
"'%s'"

#: https://github.com/Icinga/ipl-validator/blob/f1dcd1d7594bc4b902616b875d5ddf8f0c1d907c/src/EmailAddressValidator.php#L301
#, php-format
msgid ""
"'%s' is not in a routable network segment. The email address '%s' should not "
"be resolved from public network"
msgstr ""
"'%s' не находится в маршрутизируемом сегменте сети. Адрес электронной почты "
"'%s' не может быть разрешен из публичной сети"

#: https://github.com/Icinga/ipl-validator/blob/f1dcd1d7594bc4b902616b875d5ddf8f0c1d907c/src/FileValidator.php#L190
#, php-format
msgid "File %s is bigger than the allowed maximum size of %d"
msgstr "Файл %s больше допустимого максимального размера %d"

#: https://github.com/Icinga/ipl-validator/blob/f1dcd1d7594bc4b902616b875d5ddf8f0c1d907c/src/FileValidator.php#L200
#, php-format
msgid "File %s is smaller than the minimum required size of %d"
msgstr "Файл %s меньше минимально необходимого размера %d"

#: https://github.com/Icinga/ipl-validator/blob/f1dcd1d7594bc4b902616b875d5ddf8f0c1d907c/src/FileValidator.php#L213
#, php-format
msgid "File name is longer than the allowed length of %d characters."
msgstr "Имя файла превышает допустимую длину в %d символов."

#: https://github.com/Icinga/ipl-validator/blob/f1dcd1d7594bc4b902616b875d5ddf8f0c1d907c/src/FileValidator.php#L242
#, php-format
msgid "File %s is of type %s. Only %s allowed."
msgstr "Файл %s имеет тип %s. Допускается только %s."

#: https://github.com/Icinga/ipl-validator/blob/f1dcd1d7594bc4b902616b875d5ddf8f0c1d907c/src/GreaterThanValidator.php#L63
#, php-format
msgid "'%s' is not greater than '%s'"
msgstr "'%s' не больше чем '%s'"

#: https://github.com/Icinga/ipl-validator/blob/f1dcd1d7594bc4b902616b875d5ddf8f0c1d907c/src/HexColorValidator.php#L24
#, php-format
msgid "Color string not in the expected format %s"
msgstr "Цветная строка не в ожидаемом формате %s"

#: https://github.com/Icinga/ipl-validator/blob/f1dcd1d7594bc4b902616b875d5ddf8f0c1d907c/src/HostnameValidator.php#L24
#, php-format
msgid "%s is not a valid host name."
msgstr "%s недействительное имя хоста."

#: https://github.com/Icinga/ipl-validator/blob/f1dcd1d7594bc4b902616b875d5ddf8f0c1d907c/src/InArrayValidator.php#L96
#, php-format
msgid "%s was not found in the haystack"
msgid_plural "%s were not found in the haystack"
msgstr[0] "%s не был найден в стоге сена"
msgstr[1] "%s не было найдено в стоге сена"
msgstr[2] "%s не были найдены в стоге сена"

#: https://github.com/Icinga/ipl-validator/blob/f1dcd1d7594bc4b902616b875d5ddf8f0c1d907c/src/LessThanValidator.php#L62
#, php-format
msgid "'%s' is not less than '%s'"
msgstr "'%s' не меньше, чем '%s'"

#: https://github.com/Icinga/ipl-validator/blob/f1dcd1d7594bc4b902616b875d5ddf8f0c1d907c/src/PrivateKeyValidator.php#L21
#: https://github.com/Icinga/ipl-validator/blob/f1dcd1d7594bc4b902616b875d5ddf8f0c1d907c/src/X509CertValidator.php#L20
msgid "URLs are not allowed"
msgstr "URL-адреса не допускаются"

#: https://github.com/Icinga/ipl-validator/blob/f1dcd1d7594bc4b902616b875d5ddf8f0c1d907c/src/PrivateKeyValidator.php#L27
msgid "Not a valid PEM-encoded private key"
msgstr "Недопустимый приватный ключ в PEM-кодировке"

#: https://github.com/Icinga/ipl-validator/blob/f1dcd1d7594bc4b902616b875d5ddf8f0c1d907c/src/RegexSyntaxValidator.php#L20
msgid "Invalid regex given, must be a string"
msgstr ""

#: https://github.com/Icinga/ipl-validator/blob/f1dcd1d7594bc4b902616b875d5ddf8f0c1d907c/src/RegexSyntaxValidator.php#L27
#, php-format
msgid "Regex \"%s\" failed to compile: %s"
msgstr ""

#: https://github.com/Icinga/ipl-validator/blob/f1dcd1d7594bc4b902616b875d5ddf8f0c1d907c/src/StringLengthValidator.php#L163
#: https://github.com/Icinga/ipl-validator/blob/f1dcd1d7594bc4b902616b875d5ddf8f0c1d907c/src/StringLengthValidator.php#L173
#, php-format
msgid "String should be %d characters long, %d given"
msgstr "Длина строки должна составлять %d символов, получено %d"

#: https://github.com/Icinga/ipl-validator/blob/f1dcd1d7594bc4b902616b875d5ddf8f0c1d907c/src/X509CertValidator.php#L26
msgid "Not a valid PEM-encoded X.509 certificate"
msgstr "Недействительный сертификат X.509 с PEM-кодировкой"
